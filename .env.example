# Convex deployment URL (set by init_app_project tool or npx convex dev)
VITE_CONVEX_URL=

# For local development with npx convex dev
# CONVEX_DEPLOY_KEY=

# Auth private key (RSA 2048, generated automatically)
# AUTH_PRIVATE_KEY=

# Set to "true" on preview/dev deployments to register the @test.local
# credentials provider (test sign-in). Leave unset/false on production.
# IS_PREVIEW=

# Shared secret used to verify HMAC-signed SSO tokens from Central Manager.
# Must match the value configured in Central Manager.
# SSO_SHARED_SECRET=

# SMTP server for outbound email (verification + password-reset OTPs).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Slack incoming webhook for the daily vulnerability alert (convex/vulnScan.ts).
# SLACK_WEBHOOK_URL=

# Public dashboard origin used in Slack alert links (convex/vulnScan.ts).
# APP_URL=

# Origin of the server-management component (credential hub) this app calls.
# VITE_SERVER_MANAGEMENT_URL=
